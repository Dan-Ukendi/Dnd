# Postgres (Neon): pooled URL for the application
DATABASE_URL=postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Direct (non-pooled) URL used by Alembic migrations; falls back to DATABASE_URL when empty
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# At least 32 random characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# World Anvil Boromir API credentials
WA_APPLICATION_KEY=
WA_AUTH_TOKEN=
WA_WORLD_ID=
# production (secure cookies, HSTS) or development (plain HTTP on localhost)
APP_ENV=production
# Temporary password for new or reset player accounts
PLAYER_INITIAL_PASSWORD=0000
# true: players must replace the temporary password at their first login
PLAYER_PASSWORD_CHANGE=false
